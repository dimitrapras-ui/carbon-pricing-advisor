def analyze_company_profile(company_data):
    """
    STEP 1: Deep analysis of company characteristics
    Returns: Risk profile, ambition level, constraints
    """
    
    # Calculate emissions intensity (if we have revenue data)
    # For now, we'll classify based on emissions and size
    emissions = company_data['emissions']
    size = company_data['size']
    
    # Determine emissions intensity category
    if emissions < 10000:
        intensity = "Low"
        intensity_desc = "Relatively low operational footprint"
    elif emissions < 100000:
        intensity = "Medium"
        intensity_desc = "Moderate emissions profile"
    else:
        intensity = "High"
        intensity_desc = "Significant emissions intensity"
    
    # Calculate target ambition
    target_pct = company_data['target_pct']
    target_year = company_data['target_year']
    years_to_target = target_year - 2026  # Assuming current year is 2026
    annual_reduction_rate = target_pct / years_to_target if years_to_target > 0 else 0
    
    if annual_reduction_rate >= 8:
        ambition = "Very Aggressive"
        ambition_desc = f"{target_pct}% in {years_to_target} years = {annual_reduction_rate:.1f}%/year (demanding pace)"
    elif annual_reduction_rate >= 5:
        ambition = "Aggressive"
        ambition_desc = f"{target_pct}% in {years_to_target} years = {annual_reduction_rate:.1f}%/year (ambitious)"
    elif annual_reduction_rate >= 3:
        ambition = "Moderate"
        ambition_desc = f"{target_pct}% in {years_to_target} years = {annual_reduction_rate:.1f}%/year (reasonable pace)"
    else:
        ambition = "Conservative"
        ambition_desc = f"{target_pct}% in {years_to_target} years = {annual_reduction_rate:.1f}%/year (gradual)"
    
    # Assess industry pressure based on sector
    industry = company_data['industry']
    pressure_map = {
        'Technology': ('High', 'Tech sector under intense scrutiny from investors and public'),
        'Finance': ('High', 'Financial services face regulatory pressure and reputational risk'),
        'Consumer Goods': ('High', 'Direct consumer pressure and brand reputation at stake'),
        'Oil & Gas': ('Very High', 'Existential pressure to transform business model'),
        'Energy & Utilities': ('Very High', 'Core of energy transition, heavy regulation'),
        'Manufacturing': ('Medium', 'Competitive pressures but energy costs are material')
    }
    pressure, pressure_desc = pressure_map.get(industry, ('Medium', 'Growing stakeholder expectations'))
    
    # Assess financial capacity based on size
    capacity_map = {
        '<$100M': ('Low', 'Limited resources for ambitious carbon pricing'),
        '$100M-$1B': ('Medium', 'Moderate capacity, price must be carefully calibrated'),
        '$1B-$10B': ('High', 'Strong capacity to absorb carbon pricing impacts'),
        '>$10B': ('Very High', 'Substantial resources, can afford ambitious pricing')
    }
    capacity, capacity_desc = capacity_map.get(size, ('Medium', 'Moderate financial capacity'))
    
    return {
        'emissions_intensity': {
            'level': intensity,
            'description': intensity_desc,
            'annual_emissions': f"{emissions:,} tons CO2e"
        },
        'target_ambition': {
            'level': ambition,
            'description': ambition_desc,
            'annual_rate': f"{annual_reduction_rate:.1f}%/year"
        },
        'industry_pressure': {
            'level': pressure,
            'description': pressure_desc
        },
        'financial_capacity': {
            'level': capacity,
            'description': capacity_desc
        }
    }


def calculate_target_consistent_price(company_data, profile):
    """
    STEP 2: Mathematical calculation of price needed to hit target
    Uses price elasticity and abatement cost curves
    """
    
    target_pct = company_data['target_pct']
    target_year = company_data['target_year']
    years_to_target = target_year - 2026
    
    # Price elasticity estimates from literature
    # Most studies show elasticity between -0.7 and -1.2
    # We'll use -0.9 as middle estimate
    elasticity = -0.9
    
    # Base calculation: What carbon price drives X% reduction?
    # Formula: reduction % = elasticity × ln(1 + price/baseline)
    # Solving for price: price = baseline × (e^(reduction/elasticity) - 1)
    
    # Baseline carbon price assumption (implicit cost of business as usual)
    baseline = 30  # Rough estimate of implicit carbon cost
    
    # Calculate required price for target
    import math
    reduction_fraction = target_pct / 100
    price_multiplier = math.exp(reduction_fraction / abs(elasticity)) - 1
    target_price = baseline * price_multiplier
    
    # Add confidence intervals (±20%)
    price_low = target_price * 0.8
    price_high = target_price * 1.2
    
    # Adjust based on ambition level
    if profile['target_ambition']['level'] in ['Very Aggressive', 'Aggressive']:
        confidence = 'Medium'
        confidence_note = 'Aggressive targets have higher uncertainty - technology costs and behavioral response are key variables'
    else:
        confidence = 'High'
        confidence_note = 'Moderate targets have well-established abatement cost curves'
    
    return {
        'method': 'Marginal abatement cost curve analysis with price elasticity modeling',
        'target_price': round(target_price),
        'range': f"${round(price_low)}-${round(price_high)}/ton",
        'confidence': confidence,
        'confidence_note': confidence_note,
        'calculation_details': {
            'elasticity_used': elasticity,
            'baseline_assumption': f"${baseline}/ton implicit cost",
            'reduction_needed': f"{target_pct}% over {years_to_target} years"
        },
        'assumptions': [
            f"Price elasticity of demand: {elasticity}",
            "Linear reduction pathway",
            "No major technology cost breakthroughs",
            "Behavioral response consistent with historical data"
        ]
    }


