def generate_trajectory(company_data, base_recommendation):
    """
    MODULE 6: Year-by-Year Trajectory
    Shows path from present to target year
    """
    
    base_price = base_recommendation['recommended_price']
    start_year = 2026
    target_year = company_data['target_year']
    target_pct = company_data['target_pct']
    emissions = company_data['emissions']
    
    # Calculate escalation (3% per year)
    escalation_rate = 0.03
    
    trajectory = {}
    cumulative_reduction = 0
    
    for year in range(start_year, target_year + 1):
        years_elapsed = year - start_year
        
        # Price with escalation
        current_price = round(base_price * ((1 + escalation_rate) ** years_elapsed))
        
        # Estimate annual reduction (diminishing returns)
        # Early years: higher reduction per dollar
        # Later years: harder/more expensive reductions
        if years_elapsed == 0:
            annual_reduction = 8
        elif years_elapsed == 1:
            annual_reduction = 9
        elif years_elapsed == 2:
            annual_reduction = 10
        elif years_elapsed == 3:
            annual_reduction = 9
        else:
            annual_reduction = 6
        
        cumulative_reduction += annual_reduction
        
        # Estimate actions triggered at this price level
        if current_price < 50:
            actions = ["LED lighting retrofits", "HVAC optimization", "Basic efficiency measures"]
        elif current_price < 75:
            actions = ["Renewable energy PPAs", "Building envelope improvements", "Fleet efficiency"]
        elif current_price < 100:
            actions = ["On-site solar installation", "Heat pump conversions", "Process electrification"]
        else:
            actions = ["Advanced storage systems", "Green hydrogen pilots", "Deep retrofits"]
        
        # Cost calculation
        annual_cost = round((emissions * (1 - cumulative_reduction/100)) * current_price)
        
        trajectory[str(year)] = {
            'price': f"${current_price}/ton",
            'annual_reduction': f"{annual_reduction}%",
            'cumulative_reduction': f"{min(cumulative_reduction, target_pct)}%",
            'emissions_remaining': f"{round(emissions * (1 - min(cumulative_reduction, target_pct)/100)):,} tons CO2e",
            'annual_cost': f"${annual_cost:,}",
            'actions_triggered': actions,
            'on_track': cumulative_reduction >= (target_pct * years_elapsed / (target_year - start_year))
        }
    
    # Final assessment
    final_cumulative = min(cumulative_reduction, target_pct + 10)
    gap_to_target = max(0, target_pct - final_cumulative)
    
    return {
        'start_year': start_year,
        'target_year': target_year,
        'yearly_progression': trajectory,
        'final_assessment': {
            'projected_final_reduction': f"{final_cumulative}%",
            'target_reduction': f"{target_pct}%",
            'gap': f"{gap_to_target} percentage points",
            'on_track': gap_to_target <= 5,
            'summary': f"Trajectory projects {final_cumulative}% reduction by {target_year}. Target is {target_pct}%, leaving {gap_to_target}pp gap that requires complementary policies." if gap_to_target > 0 else f"Trajectory exceeds {target_pct}% target, achieving {final_cumulative}% reduction by {target_year}."
        }
    }


